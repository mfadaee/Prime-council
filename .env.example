# Prime Council — copy to .env.local and fill in what you need.
# Nothing here is required: with no keys the app runs in labelled demo mode.
# Keys are read on the server only; they are never sent to the browser,
# stored in the database, or written to transcripts/logs.

# --- Database -----------------------------------------------------------------
# Leave unset to use the embedded PostgreSQL (PGlite) stored in ./.data/pglite.
# For a real PostgreSQL server (e.g. `docker compose up -d db`):
# DATABASE_URL=postgres://simlife:simlife@localhost:5432/simlife
# PGLITE_DIR=./.data/pglite

# --- Model providers (set only the ones you use) -------------------------------
# Each configured model family gets its own Prime on first start (one Prime per AI model).
# A family is used when its key/URL AND a model id are set (Anthropic defaults to claude-opus-5-5).
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# OPENAI_API_KEY=
# OPENAI_MODEL=            # e.g. a model id listed by "Check now" on the Members page
# GEMINI_API_KEY=
# GEMINI_MODEL=

# Any OpenAI-compatible /v1/chat/completions server (vLLM, LM Studio, llama.cpp, OpenRouter…)
# OPENAI_COMPAT_BASE_URL=http://localhost:1234/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=

# Ollama (defaults to http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Optional: put every Prime on one provider/model instead (first start only).
# SIMLIFE_DEFAULT_PROVIDER=ollama
# SIMLIFE_DEFAULT_MODEL=llama3.2

# --- Modes ----------------------------------------------------------------------
# Force every seat onto the simulated demo provider (no model calls at all).
# SIMLIFE_DEMO=1

# --- Access ---------------------------------------------------------------------
# Unset: the app only answers requests addressed to localhost (default, recommended).
# Set a long random value before exposing the app beyond your machine; the Prime
# then signs in at /login. Example: openssl rand -hex 32
# SIMLIFE_ACCESS_TOKEN=
